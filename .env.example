# =============================================================================
#  Bot-alertepk — exemple de configuration
#  Copiez ce fichier en .env puis renseignez vos valeurs.
#  AUCUN secret ne doit etre commite : .env est ignore par git.
# =============================================================================

# --- Serveur web local ---
HOST=127.0.0.1
PORT=8000

# --- Base de donnees (SQLite par defaut, rien a installer) ---
# DATABASE_URL=sqlite:////chemin/absolu/vers/pokebot.db

# --- Planification ---
SCAN_INTERVAL_MINUTES=60        # scan automatique toutes les X minutes

# --- Reseau / politesse envers les sites ---
REQUEST_TIMEOUT=20              # secondes
RATE_LIMIT_SECONDS=2.0          # delai minimum entre 2 requetes vers le meme domaine
RESPECT_ROBOTS=true             # respecter robots.txt
USER_AGENT=PokeAlertBot/1.0 (+https://github.com/nerdyeu/bot-alertepk; veille tarifaire personnelle)

# --- Logique d'alerte ---
GLOBAL_THRESHOLD_PCT=5          # seuil global : alerte si prix <= cote - 5%
ENABLE_STOCK_FILTER=true        # n'alerter que si reellement en stock
ALERT_MIN_PRICE_DROP_PCT=2      # anti-spam : nouvelle alerte seulement si le prix rebaisse d'au moins 2%
ALERT_COOLDOWN_HOURS=24         # ... ou si ce delai est ecoule
MATCH_MIN_SCORE=80              # score minimal (0-100) pour accepter une correspondance de nom
IMAGE_MATCH_ENABLED=true        # confirmation secondaire par image si dispo
IMAGE_MATCH_MAX_DISTANCE=12     # distance perceptuelle max (phash) pour confirmer une image

# --- Prix de reference (ZebraDex) ---
# manual   = vous saisissez/mettez a jour la cote dans l'interface (recommande, aucun risque CGU)
# zebradex = lecture via API/identifiants (voir README ; desactive par defaut)
REFERENCE_PROVIDER=manual
REFERENCE_REFRESH_HOURS=24
# ZEBRADEX_API_BASE=            # si vous decouvrez une API publique/d'app ZebraDex
# ZEBRADEX_EMAIL=               # vos identifiants ZebraDex (jamais utilises sans votre accord)
# ZEBRADEX_PASSWORD=

# --- Notifications ---
# Canaux actifs, separes par des virgules : discord,telegram (l'UI affiche toujours les alertes)
NOTIFY_CHANNELS=
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_CHAT_ID=123456789
